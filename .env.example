# Optional Vertex AI / Gemini fallback configuration for `asof filing-extract --vertex-project`
GOOGLE_CLOUD_PROJECT=
VERTEX_MODEL=gemini-3.5-flash-lite

# Optional direct Gemini / hosted provider keys for future adapters
GEMINI_API_KEY=

# Optional local data paths for `asof serve` / `asof factors`
ASOF_CATALOG_DIR=./local-data/catalog
ASOF_UNIVERSE_DIR=./local-data/universe
